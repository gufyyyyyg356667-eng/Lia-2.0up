<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed only for the system-wide edge glow. The user must grant "Display over other apps". -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Brightness control. The user grants this once in Settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application>
        <service
            android:name="com.Lia.assistant.wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="com.Lia.assistant.access.NovaAccessibilityService"
            android:exported="false"
            android:label="Lia AI screen control"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
